{
  "name": "@electron-resize-sync/drag-edge-heuristic",
  "version": "0.1.0",
  "description": "Guess which edges a user resize drags in Electron on macOS, where will-resize does not report them. A heuristic; it can be wrong.",
  "keywords": [
    "electron",
    "macos",
    "resize",
    "will-resize"
  ],
  "homepage": "https://github.com/lennondotw/electron-resize-sync/tree/main/packages/drag-edge-heuristic#readme",
  "bugs": {
    "url": "https://github.com/lennondotw/electron-resize-sync/issues"
  },
  "license": "MIT",
  "author": "lennondotw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennondotw/electron-resize-sync.git",
    "directory": "packages/drag-edge-heuristic"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./main": {
      "development": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "electron": ">=44.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
