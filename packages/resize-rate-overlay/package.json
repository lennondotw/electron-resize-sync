{
  "name": "@electron-resize-sync/resize-rate-overlay",
  "version": "0.1.0",
  "description": "WORKS (diagnostic). A click-through label that shows how often a window actually changes size.",
  "keywords": [
    "electron",
    "macos",
    "resize"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./main": {
      "development": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "electron": ">=44.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
