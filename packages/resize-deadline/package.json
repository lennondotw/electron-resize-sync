{
  "name": "@electron-resize-sync/resize-deadline",
  "version": "0.1.0",
  "description": "Keep Electron window content in step with the frame during live resize on macOS: a patch that makes resizes wait for the page's frame, and the switches it needs.",
  "keywords": [
    "electron",
    "jank",
    "live-resize",
    "macos",
    "resize",
    "surface-synchronization"
  ],
  "homepage": "https://github.com/lennondotw/electron-resize-sync/tree/main/packages/resize-deadline#readme",
  "bugs": {
    "url": "https://github.com/lennondotw/electron-resize-sync/issues"
  },
  "license": "MIT",
  "author": "lennondotw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennondotw/electron-resize-sync.git",
    "directory": "packages/resize-deadline"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "electron-v44.4.5-resize-deadline.patch",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./main": {
      "development": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./patch": {
      "development": "./src/patch.ts",
      "types": "./dist/patch.d.ts",
      "default": "./dist/patch.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./patch": {
        "types": "./dist/patch.d.ts",
        "default": "./dist/patch.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "electron": ">=44.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
