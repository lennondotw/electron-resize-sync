{
  "name": "electron-resize-sync",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @electron-resize-sync/demo dev",
    "start": "pnpm build && pnpm --filter @electron-resize-sync/demo start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p experiments/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "@electron-resize-sync/resize-deadline": "workspace:^",
    "@types/node": "^24.13.6",
    "@types/pngjs": "^6.0.5",
    "electron": "catalog:",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
